#event_simpleName = ProcessRollup2 | ImageFileName = /socat/i | CommandLine = /exec:/i | CommandLine = /-listen:/i | groupBy([ComputerName, OriginalFileName, ParentProcessId, CommandLine, ProcessGuid, ProcessHash, ProcessId, CurrentDirectory, ImageFileName, ImageFilePath, UserName, UserId, VendorProduct], function=[count(), first(as=firstTime, field=@timestamp), last(as=lastTime, field=@timestamp)]) | rename(field=ComputerName, as=dest) | rename(field=ImageFileName, as=process_name) | rename(field=ImageFilePath, as=process_path) | rename(field=CurrentDirectory, as=process_current_directory) | rename(field=ProcessGuid, as=process_guid) | rename(field=ProcessHash, as=process_hash) | rename(field=ProcessId, as=process_id)